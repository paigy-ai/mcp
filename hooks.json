{
  "paigy": {
    "SessionStart": [
      {
        "type": "command",
        "command": "./scripts/session-start.sh",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "npx -y -p @paigy/mcp@latest paigy-stalled",
        "timeout": 60
      }
    ]
  }
}
